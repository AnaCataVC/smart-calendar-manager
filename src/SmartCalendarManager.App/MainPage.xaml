<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SmartCalendarManager.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SmartCalendarManager.Core.Models"
    mc:Ignorable="d">

    <Grid>
        <NavigationView
            x:Name="NavView"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Agenda" Tag="Agenda" Icon="Calendar" IsSelected="True" />
                <NavigationViewItem Content="Automatizaciones" Tag="Cron" Icon="Play" />
            </NavigationView.MenuItems>

            <!-- Pre-Meeting Dismissible Banner -->
            <Grid Padding="24,12,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    Grid.Row="0"
                    IsOpen="{x:Bind ViewModel.Agenda.IsBannerVisible, Mode=OneWay}"
                    Severity="Informational"
                    Title="Reunión próxima"
                    Message="{x:Bind ViewModel.Agenda.ActiveBannerEvent.Title, Mode=OneWay}"
                    IsClosable="True"
                    CloseButtonClick="InfoBar_CloseButtonClick"
                    Margin="0,0,0,16">
                    <InfoBar.ActionButton>
                        <Button Content="Unirse ahora" Command="{x:Bind ViewModel.Agenda.JoinMeetingCommand}" CommandParameter="{x:Bind ViewModel.Agenda.ActiveBannerEvent, Mode=OneWay}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- 1. AGENDA VIEW -->
                <Grid x:Name="AgendaSection" Grid.Row="1" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                        <Button Content="Actualizar Agenda" Command="{x:Bind ViewModel.Agenda.RefreshEventsCommand}">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                        <TextBlock Text="Actualizar Agenda" />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                        <ProgressRing IsActive="{x:Bind ViewModel.Agenda.IsLoading, Mode=OneWay}" Width="20" Height="20" />
                        <TextBlock Text="{x:Bind ViewModel.Agenda.StatusMessage, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Agenda.TodayEvents, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CalendarEvent">
                                <Grid Padding="12" Margin="0,4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind FormattedStartTime}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="{x:Bind FormattedEndTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                            <Border Padding="6,1" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="{x:Bind FeedTag}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{x:Bind StatusText}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button
                                            Content="Abrir Granola"
                                            Visibility="{x:Bind InGranolaScope, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Click="OpenGranola_Click"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Abre Granola y el enlace de la reunión si existe" />
                                        <Button
                                            Content="Unirse"
                                            Visibility="{x:Bind MeetingLink, Converter={StaticResource StringToVisibilityConverter}}"
                                            Click="JoinMeeting_Click"
                                            Tag="{x:Bind}">
                                            <Button.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE717;" FontSize="13" />
                                                        <TextBlock Text="Unirse" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- 2. AUTOMATIONS (CRON LAUNCHER) VIEW -->
                <ScrollViewer x:Name="CronSection" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel Spacing="16" MaxWidth="800" HorizontalAlignment="Left">
                        <TextBlock Text="Lanzador de Apps Programado (Cron Visual)" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Configura reglas automáticas para abrir herramientas (Slack, navegadores, programas) en horarios específicos sin escribir sintaxis cron compleja." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <!-- Form to add new rule -->
                        <Grid Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Crear Nueva Regla" FontWeight="SemiBold" FontSize="16" />
                                <TextBox Header="Nombre de la Regla" Text="{x:Bind ViewModel.CronLauncher.NewRuleName, Mode=TwoWay}" PlaceholderText="ej: Abrir Slack mañana" />
                                <TextBox Header="Destino (URI / Ejecutable / URL)" Text="{x:Bind ViewModel.CronLauncher.NewRuleTarget, Mode=TwoWay}" PlaceholderText="ej: slack:// o C:\Apps\app.exe o https://meet.google.com" />
                                <TimePicker Header="Hora de Disparo" Time="{x:Bind ViewModel.CronLauncher.NewRuleTime, Mode=TwoWay}" ClockIdentifier="12HourClock" />

                                <TextBlock Text="Días de la semana" FontWeight="Medium" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ToggleButton Content="L" IsChecked="{x:Bind ViewModel.CronLauncher.Mon, Mode=TwoWay}" Width="36" Height="36" />
                                    <ToggleButton Content="M" IsChecked="{x:Bind ViewModel.CronLauncher.Tue, Mode=TwoWay}" Width="36" Height="36" />
                                    <ToggleButton Content="X" IsChecked="{x:Bind ViewModel.CronLauncher.Wed, Mode=TwoWay}" Width="36" Height="36" />
                                    <ToggleButton Content="J" IsChecked="{x:Bind ViewModel.CronLauncher.Thu, Mode=TwoWay}" Width="36" Height="36" />
                                    <ToggleButton Content="V" IsChecked="{x:Bind ViewModel.CronLauncher.Fri, Mode=TwoWay}" Width="36" Height="36" />
                                    <ToggleButton Content="S" IsChecked="{x:Bind ViewModel.CronLauncher.Sat, Mode=TwoWay}" Width="36" Height="36" />
                                    <ToggleButton Content="D" IsChecked="{x:Bind ViewModel.CronLauncher.Sun, Mode=TwoWay}" Width="36" Height="36" />
                                </StackPanel>

                                <Button Content="Guardar Regla" Command="{x:Bind ViewModel.CronLauncher.AddRuleCommand}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Existing rules list -->
                        <TextBlock Text="Reglas Configuradas" FontWeight="SemiBold" FontSize="16" Margin="0,12,0,0" />
                        <ListView ItemsSource="{x:Bind ViewModel.CronLauncher.Rules, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:CronLauncherRule">
                                    <Grid Padding="12" Margin="0,4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock Text="{x:Bind FormattedDays}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                            <TextBlock Text="{x:Bind FormattedTime}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="13" FontWeight="Medium" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <ToggleButton Content="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                          IsChecked="{x:Bind IsEnabled}"
                                                          Click="ToggleRule_Click" Tag="{x:Bind}"
                                                          ToolTipService.ToolTip="Activar / Desactivar" />
                                            <Button Content="Probar" Click="TestRun_Click" Tag="{x:Bind}" />
                                            <Button Content="Eliminar" Click="DeleteRule_Click" Tag="{x:Bind}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. SETTINGS VIEW -->
                <ScrollViewer x:Name="SettingsSection" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel Spacing="16" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="Configuración" FontSize="20" FontWeight="SemiBold" />

                        <Expander Header="Calendarios (feeds iCal)" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Pega la dirección secreta en formato iCal de cada calendario (Google Calendar → Configuración del calendario → Integrar calendario). Marca como Personal los calendarios que no son del trabajo." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ListView ItemsSource="{x:Bind ViewModel.Settings.Feeds}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:CalendarFeed">
                                            <Grid Padding="8" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind KindLabel}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind Url}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Enabled, Mode=TwoWay}" OnContent="Activo" OffContent="Inactivo" MinWidth="0" />
                                                <Button Grid.Column="2" Content="Eliminar" Click="DeleteFeed_Click" Tag="{x:Bind}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <TextBlock Text="Agregar calendario" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBox Header="Nombre" Text="{x:Bind ViewModel.Settings.NewFeedName, Mode=TwoWay}" PlaceholderText="ej: Trabajo, Gmail, Familia" />
                                <TextBox Header="URL iCal secreta (.ics)" Text="{x:Bind ViewModel.Settings.NewFeedUrl, Mode=TwoWay}" PlaceholderText="https://calendar.google.com/calendar/ical/.../private-.../basic.ics" />
                                <PasswordBox Header="Contraseña HTTP Basic (opcional, solo si el feed la exige)" Password="{x:Bind ViewModel.Settings.NewFeedKey, Mode=TwoWay}" />
                                <RadioButtons Header="Tipo" MaxColumns="2" SelectedIndex="{x:Bind ViewModel.Settings.NewFeedKindIndex, Mode=TwoWay}">
                                    <x:String>Laboral</x:String>
                                    <x:String>Personal</x:String>
                                </RadioButtons>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Content="Agregar" Command="{x:Bind ViewModel.Settings.AddFeedCommand}" />
                                    <ProgressRing IsActive="{x:Bind ViewModel.Settings.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Granola" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Granola se abre antes de cada reunión elegible (con enlace de videollamada, si lo exiges en Filtros), y el botón Abrir Granola aparece en la agenda para esos eventos." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <RadioButtons Header="Aplicar Granola a" SelectedIndex="{x:Bind ViewModel.Settings.GranolaScopeIndex, Mode=TwoWay}">
                                    <x:String>Solo calendarios laborales</x:String>
                                    <x:String>Calendarios laborales y personales</x:String>
                                </RadioButtons>
                                <NumberBox Header="Minutos de anticipación" Value="{x:Bind ViewModel.Settings.GranolaLeadMinutes, Mode=TwoWay}" Minimum="0" Maximum="60" SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Expander>

                        <Expander Header="Filtros de eventos" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <TextBox Header="Palabras Clave Excluidas (separadas por coma)" Text="{x:Bind ViewModel.Settings.ExcludedKeywords, Mode=TwoWay}" />
                                <ToggleSwitch Header="Ignorar eventos de todo el día" IsOn="{x:Bind ViewModel.Settings.IgnoreAllDay, Mode=TwoWay}" />
                                <ToggleSwitch Header="Abrir Granola solo si hay enlace de reunión (Meet/Zoom/Teams/Webex)" IsOn="{x:Bind ViewModel.Settings.RequireLink, Mode=TwoWay}" />
                            </StackPanel>
                        </Expander>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Guardar Configuración" Command="{x:Bind ViewModel.Settings.SaveCalendarSettingsCommand}" Style="{StaticResource AccentButtonStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Settings.StatusMessage, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <Expander Header="Bloqueo en calendario laboral (Apps Script)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Este script crea eventos privados de bloqueo en tu calendario laboral cada vez que tienes algo en tus calendarios personales activos. Corre dentro de tu cuenta laboral en script.google.com; la app solo lo genera." />
                                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Text="Ojo: las URLs iCal secretas de tus calendarios personales quedan dentro del script en tu cuenta laboral. Los eventos recurrentes (RRULE) no se expanden: solo se considera su primera ocurrencia." />
                                <TextBox Header="Título del evento de bloqueo" Text="{x:Bind ViewModel.Settings.BlockTitle, Mode=TwoWay}" />
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="1. Entra con tu cuenta laboral y abre script.google.com (nuevo proyecto)." /><LineBreak />
                                    <Run Text="2. Copia el script de abajo y pégalo reemplazando el contenido de Código.gs." /><LineBreak />
                                    <Run Text="3. Ejecuta la función syncBlocks una vez y acepta los permisos." /><LineBreak />
                                    <Run Text="4. En Activadores, agrega uno para syncBlocks, basado en tiempo, cada 15 minutos." /><LineBreak />
                                    <Run Text="5. Si agregas o quitas calendarios personales, vuelve a copiar el script." />
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Content="Copiar script" Click="CopyScript_Click" />
                                    <Button Content="Abrir script.google.com" Command="{x:Bind ViewModel.Settings.OpenScriptEditorCommand}" />
                                </StackPanel>
                                <TextBox Text="{x:Bind ViewModel.Settings.GeneratedScript, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                         FontFamily="Consolas" FontSize="12" Height="280"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Expander>

                        <Grid Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Actualizaciones de Software" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="{x:Bind ViewModel.Settings.CurrentVersion, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button Content="Buscar Actualizaciones" Command="{x:Bind ViewModel.Settings.CheckForUpdatesCommand}" />
                                <TextBlock Text="{x:Bind ViewModel.Settings.UpdateStatusText, Mode=OneWay}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                                <!-- Download section — visible only when an update is available -->
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0"
                                            Visibility="{x:Bind ViewModel.Settings.IsUpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button Content="Descargar e Instalar"
                                            Command="{x:Bind ViewModel.Settings.DownloadAndInstallUpdateCommand}"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    <ProgressRing IsActive="{x:Bind ViewModel.Settings.IsDownloading, Mode=OneWay}"
                                                  Width="20" Height="20" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.Settings.DownloadProgress, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                                           Visibility="{x:Bind ViewModel.Settings.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Page>



